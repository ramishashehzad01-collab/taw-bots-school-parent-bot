# Reference only. These values are NOT automatically loaded by the n8n exports.
# Create/update the matching credentials in n8n's Credentials UI.

# Supabase project
SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Groq LLM
GROQ_API_KEY=YOUR_GROQ_API_KEY

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN
WHATSAPP_VERIFY_TOKEN=YOUR_RANDOM_WEBHOOK_VERIFY_TOKEN

# Public n8n address used for Meta webhook configuration
N8N_PUBLIC_URL=https://YOUR_PUBLIC_N8N_DOMAIN

# WhatsApp message template (must exist and be approved before proactive broadcast)
WHATSAPP_TEMPLATE_NAME=school_notice_broadcast
WHATSAPP_TEMPLATE_LANGUAGE=en_US
